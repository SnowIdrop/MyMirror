# 仅供朋友在自己电脑上使用；不要复制发送者的 .env 或 data/。
PORT=40002
TZ=Asia/Shanghai

# 首次启动前分别填写独立的随机值；不要保留空值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
GATEWAY_ADMIN_SECRET=
DJANGO_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# 仅适用于本机 HTTP 访问。若将来配置 HTTPS，须重新设置安全 Cookie 和域名。
DJANGO_DEBUG=false
DJANGO_ALLOW_ALL_ORIGINS=disable
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:40002,http://127.0.0.1:40002
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
COOKIE_SECURE=false

ALLOW_REGISTER=false
CLOUDFLARE_TURNSTILE=disable
CF_BYPASS_HEADLESS=true
STARTUP_TIMEOUT_SECONDS=60
