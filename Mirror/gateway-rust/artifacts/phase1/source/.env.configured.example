# Configuration template only: not an approved production deployment.
# Keep secrets in the service environment; never ship them to the browser.
GATEWAY_UPSTREAM_MODE=configured
GATEWAY_COMPAT_PROFILE=mirror
HOST=127.0.0.1
PORT=40002
DATABASE_PATH=data/gateway-new.db
GATEWAY_ADMIN_SECRET=SET_A_UNIQUE_SERVICE_SECRET
CREDENTIAL_ENCRYPTION_KEY=SET_A_UNIQUE_ENCRYPTION_KEY_AT_LEAST_32_BYTES
DJANGO_UPSTREAM=http://django:8000
CHATGPT_BASE_URL=https://chat.example.invalid
CHATGPT_CDN_BASE_URL=https://static.example.invalid
# CF_BYPASS_URL=http://cfbypass:8000
COOKIE_SECURE=true
REQUEST_TIMEOUT_SECS=180
