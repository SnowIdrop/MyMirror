r.offsetHeight);\n      var nextX = clamp(x, 0, maxX);\n      anchor.style.left = nextX + 'px';\n      anchor.style.top = clamp(y, 0, maxY) + 'px';\n      anchor.style.right = 'auto';\n      setAnchorSide(anchor, nextX + anchor.offsetWidth / 2 < window.innerWidth / 2 ? 'left' : 'right');\n    };\n    var restorePosition = function(anchor) {\n      try {\n        var raw = window.localStorage.getItem(storageKey);\n        if (!raw) return false;\n        var saved = JSON.parse(raw);\n        if (typeof saved.x !== 'number' || typeof saved.y !== 'number') return false;\n        applyPosition(anchor, saved.x, saved.y);\n        return true;\n      } catch (error) {}\n      return false;\n    };\n    var persistPosition = function(anchor) {\n      if (anchor.getAttribute('data-collapsed') === 'true') return;\n      try {\n        window.localStorage.setItem(storageKey, JSON.stringify({\n          x: anchor.offsetLeft,\n          y: anchor.offsetTop\n        }));\n      } catch (error) {}\n    };\n    var readCollapsedState = function() {\n      try {\n        var raw = window.localStorage.getItem(collapsedStorageKey);\n        if (!raw) return null;\n        var saved = JSON.parse(raw);\n        if (!saved || typeof saved !== 'object') return null;\n        return saved;\n      } catch (error) {}\n      return null;\n    };\n    var persistCollapsedState = function(anchor) {\n      try {\n        window.localStorage.setItem(collapsedStorageKey, JSON.stringify({\n          collapsed: anchor.getAttribute('data-collapsed') === 'true',\n          side: anchor.getAttribute('data-side') === 'left' ? 'left' : 'right',\n          y: anchor.offsetTop\n        }));\n      } catch (error) {}\n    };\n    var dockCollapsed = function(anchor, side, y) {\n      var nextSide = side === 'left' ? 'left' : 'right';\n      setAnchorSide(anchor, nextSide);\n      var maxY = Math.max(0, window.innerHeight - anchor.offsetHeight);\n      var nextY = typeof y === 'number' ? y : anchor.offsetTo