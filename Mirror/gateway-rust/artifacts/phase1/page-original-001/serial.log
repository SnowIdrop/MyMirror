on.textContent = collapsed\n          ? (side === 'left' ? '›' : '‹')\n          : (side === 'left' ? '‹' : '›');\n        collapseButton.title = collapsed ? '展开控制条' : '收起到侧边栏';\n        collapseButton.setAttribute('aria-label', collapseButton.title);\n      };\n      var setCollapsed = function(collapsed, side, y) {\n        anchor.setAttribute('data-collapsed', collapsed ? 'true' : 'false');\n        if (collapsed) {\n          dockCollapsed(anchor, side || getNearestSide(anchor), y);\n          window.requestAnimationFrame(function() {\n            dockCollapsed(anchor, anchor.getAttribute('data-side'), y);\n            syncCollapseButton();\n            persistCollapsedState(anchor);\n          });\n        } else {\n          window.requestAnimationFrame(function() {\n            restoreExpandedPosition(anchor);\n            syncCollapseButton();\n            persistCollapsedState(anchor);\n            persistPosition(anchor);\n          });\n        }\n        syncCollapseButton();\n      };\n      collapseButton.onclick = function(event) {\n        event.stopPropagation();\n        var collapsed = anchor.getAttribute('data-collapsed') === 'true';\n        if (collapsed) {\n          setCollapsed(false);\n        } else {\n          setCollapsed(true, getNearestSide(anchor));\n        }\n      };\n      var dragState = null;\n      handle.addEventListener('pointerdown', function(event) {\n        if (anchor.getAttribute('data-collapsed') === 'true') return;\n        dragState = {\n          offsetX: event.clientX - anchor.offsetLeft,\n          offsetY: event.clientY - anchor.offsetTop,\n        };\n        shell.setAttribute('data-dragging', 'true');\n        handle.setPointerCapture(event.pointerId);\n        event.preventDefault();\n      });\n      handle.addEventListener('pointermove', function(event) {\n        if (!dragState) return;\n        applyPosition(anchor, event.clientX - dragState.offsetX, event.clientY - dragState.offsetY);\n        syncCollap